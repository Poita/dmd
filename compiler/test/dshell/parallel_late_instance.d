// A template instance first needed while one worker generates code, and added to
// a module another worker compiles, is still generated by the worker needing it.
module test.dshell.parallel_late_instance;

import dshell;

int main()
{
    version (Posix) {} else return DISABLED;

    Vars.set("SRC", "$EXTRA_FILES/parallel_late_instance");
    Vars.set("LIB", "$OUTPUT_BASE/ab$LIBEXT");
    Vars.set("EXE_FILE", "$OUTPUT_BASE/m$EXE");
    run("$DMD -m$MODEL -j=2 -lib -I$SRC -of=$LIB $SRC/a.d $SRC/b.d");
    run("$DMD -m$MODEL -I$SRC -of=$EXE_FILE $SRC/m.d $LIB");
    run("$EXE_FILE");
    return 0;
}
