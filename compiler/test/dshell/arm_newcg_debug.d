// Without -O, with DMD_NEWCG_FAST=1, the new AArch64 code generator generates
// every function of each program in extra-files/arm_newcg_coverage and
// extra-files/arm_newcg_debug, which run correctly, with the source line of each
// statement in the line table.
module test.dshell.arm_newcg_debug;

import dshell;
import std.algorithm : canFind, map;
import std.array : array;
import std.conv : text;
import std.file : dirEntries, readText, SpanMode;
import std.path : baseName, stripExtension;
import std.process : execute;
import std.stdio : File, writeln;
import std.string : lineSplitter;

int main()
{
    version (AArch64) {} else return DISABLED;

    int failures;
    auto srcs = dirEntries(shellExpand("$EXTRA_FILES/arm_newcg_coverage"), "*.d", SpanMode.shallow)
        .map!(e => e.name).array ~
        dirEntries(shellExpand("$EXTRA_FILES/arm_newcg_debug"), "*.d", SpanMode.shallow)
        .map!(e => e.name).array;
    foreach (src; srcs)
    {
        const name = src.baseName.stripExtension;
        const exe = OUTPUT_BASE ~ "_" ~ name ~ EXE;
        const log = OUTPUT_BASE ~ "_" ~ name ~ ".log";
        // the module's own functions, as their mangled names start
        const mangled = "_D" ~ text(name.length, name);
        foreach (flags; ["-g", "-g -check=assert=on -release", "-inline"])
        {
            {
                auto f = File(log, "w");
                run("$DMD -m$MODEL " ~ flags ~ " -of" ~ exe ~ " " ~ src, stdout, f,
                    ["DMD_NEWCG": "1", "DMD_NEWCG_FAST": "1", "DMD_NEWCG_WHY": "1", "DMD_NEWCG_LOG": "1"]);
            }
            bool generated;
            foreach (line; readText(log).lineSplitter)
            {
                if (line.canFind("newcg-why:") && line.canFind(mangled))
                {
                    writeln(name, " ", flags, ": ", line);
                    ++failures;
                }
                generated |= line.canFind("newcg: " ~ mangled);
            }
            if (!generated)
            {
                writeln(name, " ", flags, ": not generated by the new code generator");
                ++failures;
            }
            run(exe);
        }
    }

    // each statement of lines.d starts a row of the line table
    const obj = OUTPUT_BASE ~ "_lines" ~ OBJ;
    run("$DMD -m$MODEL -g -c -of" ~ obj ~ " " ~ shellExpand("$EXTRA_FILES/arm_newcg_debug/lines.d"),
        stdout, stderr, ["DMD_NEWCG": "1", "DMD_NEWCG_FAST": "1"]);
    auto r = execute(["dwarfdump", "--debug-line", obj]);
    if (r.status == 0)
    {
        bool[uint] rows;
        foreach (line; r.output.lineSplitter)
        {
            import std.algorithm : splitter;
            import std.conv : to;
            // address line column file ...
            auto w = line.splitter(' ').array;
            import std.algorithm : filter;
            auto f = w.filter!(s => s.length).array;
            if (f.length >= 2 && f[0].length > 2 && f[0][0 .. 2] == "0x")
            {
                try rows[f[1].to!uint] = true;
                catch (Exception) {}
            }
        }
        foreach (l; [3, 4, 5, 6, 11, 12, 13, 15, 16, 21, 22, 24])
            if (l !in rows)
            {
                writeln("lines.d: no row of the line table for line ", l);
                ++failures;
            }
    }
    return failures ? 1 : 0;
}
